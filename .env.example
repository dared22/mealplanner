# Shared backend configuration
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
OPENAI_API_KEY=
CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
CLERK_JWT_ISSUER=
CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=

# Instagram recipe importer
# Keep false until the Meta and Cloudinary credentials below are configured.
INSTAGRAM_IMPORTS_ENABLED=false
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v26.0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USDA_FDC_API_KEY=
RECIPE_CLASSIFIER_MODEL=gpt-5.6-luna
RECIPE_EXTRACTOR_MODEL=gpt-5.6-terra
RECIPE_TRANSCRIPTION_MODEL=gpt-4o-transcribe
RECIPE_IMPORT_POST_CONCURRENCY=3
RECIPE_IMPORT_POLL_SECONDS=3

# Set true only for the first migration of a verified pre-Alembic database.
# Take a database restore point first. The deployment workflow removes the flag
# automatically after a successful release.
ALEMBIC_ADOPT_EXISTING_SCHEMA=false
ENSURE_SCHEMA_ON_STARTUP=false

# Frontend build configuration
VITE_API_URL=http://localhost:8000
VITE_CLERK_PUBLISHABLE_KEY=
